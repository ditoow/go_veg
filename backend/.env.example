# Server
PORT=8080

# Mode penyimpanan:
# - "local"    : pakai file JSON lokal (backend/data/db.json) sebelum BE-1 siap
# - "supabase" : pakai Supabase PostgreSQL via Service Role Key setelah BE-1 push
STORAGE_MODE=local

# Mode Midtrans:
# - "mock"    : simulasi Snap & webhook lokal tanpa API key Midtrans
# - "sandbox" : tembak API Midtrans Sandbox asli (wajib isi MIDTRANS_SERVER_KEY)
MIDTRANS_MODE=mock

# Midtrans Sandbox Credentials (JANGAN commit ke Git)
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_WITH_YOUR_KEY
MIDTRANS_IS_PRODUCTION=false

# Supabase Credentials dari BE-1 (dibutuhkan saat STORAGE_MODE=supabase)
SUPABASE_URL=https://tatcjwgbswpclkarnzwh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
